{
  "name": "capri-bot",
  "version": "1.0.0",
  "description": "WhatsApp bot with the Capri persona from Cyberpunk: Edgerunners 2 (Baileys)",
  "main": "bot.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node bot.js",
    "bg": "powershell -NoProfile -ExecutionPolicy Bypass -File start-bg.ps1",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File stop-bg.ps1",
    "logs": "powershell -NoProfile -Command \"Get-Content bot.log -Tail 40 -Wait\""
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "pino": "^10.4.0",
    "qrcode-terminal": "^0.12.0",
    "youtube-dl-exec": "^3.1.17"
  },
  "allowScripts": {
    "@whiskeysockets/baileys@7.0.0-rc14": true,
    "protobufjs@7.6.6": true,
    "youtube-dl-exec@3.1.17": true
  }
}
